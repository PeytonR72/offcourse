# Optional T15 backend. Keep disabled until collection and service setup are approved.
POLL_INTAKE_ENABLED=false
# Use a restricted intake role for the web app; a trusted operator URL for the CLI.
POLL_DATABASE_URL=
# Generate at least 32 random bytes; never put this in NEXT_PUBLIC_* variables.
POLL_VOTE_SECRET=
# Optional server-backed play. T17 enforces content coverage; T18 gates release.
PLAY_ENABLED=false
# Separate server role with the documented play permissions.
PLAY_DATABASE_URL=
# Stable HMAC secret of at least 32 characters; server-only.
PLAY_SECRET=
